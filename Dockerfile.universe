# syntax=docker/dockerfile:1.7

# Universe-operated Alkanes indexer image.
#
# The stock Dockerfile clones metashrew from a third-party repository at
# v8.5.1-rc1, which is neither Universe-operated nor the revision the
# index-alkanes Marketplace authority pins. This image instead takes
# rockshrew-mono from the Universe metashrew build at an exact commit tag and
# compiles alkanes.wasm here, so the whole execution chain is first-party.
#
# Prerequisite:
#   docker build -f docker/Dockerfile.rockshrew-mono \
#     -t universe/metashrew-rockshrew:sha-<metashrew-sha12> .
#       (in bitcoinuniverseio/metashrew)
#
# Build:
#   docker build -f Dockerfile.universe \
#     --secret id=github_token,env=UNIVERSE_GITHUB_READ_TOKEN \
#     --build-arg ROCKSHREW_IMAGE=universe/metashrew-rockshrew:sha-<metashrew-sha12> \
#     --build-arg ALKANES_REVISION=<alkanes-sha> \
#     --build-arg METASHREW_REVISION=<metashrew-sha> \
#     -t universe/alkanes-indexer:sha-<alkanes-sha12> .
ARG ROCKSHREW_IMAGE=universe/metashrew-rockshrew:sha-0828fe33f353

FROM ${ROCKSHREW_IMAGE} AS rockshrew

FROM rust:1.86.0-slim-bookworm AS wasm-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      clang \
      libclang-dev \
      libssl-dev \
      pkg-config \
      protobuf-compiler \
      git \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The Alkanes crates compile protobuf definitions with prost during the build.
ENV PROTOC=/usr/bin/protoc
ENV ALKANES_BUILD_ALL_FIXTURES=1

RUN rustup target add wasm32-unknown-unknown

WORKDIR /usr/src/alkanes-rs
COPY . .

RUN --mount=type=secret,id=github_token,required=true \
    set -eu; \
    trap 'rm -f /root/.gitconfig /tmp/github-credentials' EXIT; \
    token="$(cat /run/secrets/github_token)"; \
    printf 'https://x-access-token:%s@github.com\n' "$token" > /tmp/github-credentials; \
    chmod 600 /tmp/github-credentials; \
    git config --global credential.helper 'store --file=/tmp/github-credentials'; \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
      cargo build --release --target wasm32-unknown-unknown --features mainnet

FROM debian:bookworm-slim

ARG ALKANES_REVISION=unknown
ARG METASHREW_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/bitcoinuniverseio/alkanes-rs" \
      org.opencontainers.image.revision="${ALKANES_REVISION}" \
      org.opencontainers.image.base.source="https://github.com/bitcoinuniverseio/metashrew" \
      org.opencontainers.image.base.revision="${METASHREW_REVISION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
      libssl3 \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 alkanes \
    && mkdir -p /data/rocksdb \
    && chown -R alkanes:alkanes /data

COPY --from=rockshrew /usr/local/bin/rockshrew-mono /usr/local/bin/rockshrew-mono
COPY --from=wasm-builder \
     /usr/src/alkanes-rs/target/wasm32-unknown-unknown/release/alkanes.wasm \
     /usr/local/bin/alkanes.wasm

USER alkanes
WORKDIR /data
EXPOSE 8080

# Bind to loopback by default. Alkanes state is private infrastructure and must
# not be published without an authenticated Universe gateway in front of it.
ENTRYPOINT ["rockshrew-mono", \
    "--db-path", "/data/rocksdb", \
    "--indexer", "/usr/local/bin/alkanes.wasm", \
    "--host", "127.0.0.1", \
    "--port", "8080", \
    "--start-block", "880000"]
CMD []
